---
interface Props {
  score?: number;
  handsOn: boolean;
}

const { score, handsOn } = Astro.props;
const label = score === undefined ? "Rating" : handsOn ? "My rating" : "Research score";
---

<span
  aria-label={score === undefined ? "Not rated yet" : `${label}: ${score.toFixed(1)} out of 10`}
  class="rating-badge"
>
  <span class="rating-badge-label">{label}</span>
  <strong>
    {score === undefined ? "Not rated yet" : score.toFixed(1)}
    {score !== undefined && <span aria-hidden="true"> / 10</span>}
  </strong>
</span>
