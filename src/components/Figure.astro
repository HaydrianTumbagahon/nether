---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="article-figure">
  <Image
    src={src}
    alt={alt}
    width={src.width}
    height={src.height}
    loading="lazy"
  />
  <figcaption>{caption}</figcaption>
</figure>
