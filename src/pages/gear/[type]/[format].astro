---
import { getCollection } from "astro:content";
import GearTypeArchive from "../../../components/GearTypeArchive.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { site } from "../../../config/site";

export async function getStaticPaths() {
  const formats = ["review", "guide", "comparison"] as const;
  const entries = await getCollection("posts");
  const posts = entries.filter(
    (post) => !post.data.draft || post.id.toLowerCase().includes("test"),
  );

  return site.gearTypes.flatMap((gearType) =>
    formats.map((format) => ({
      params: { type: gearType.slug, format },
      props: {
        gearType,
        format,
        posts: posts
          .filter((post) => post.data.gearType === gearType.gearType)
          .sort(
            (first, second) =>
              second.data.pubDate.getTime() - first.data.pubDate.getTime(),
          ),
      },
    })),
  );
}

const { gearType, format, posts } = Astro.props;
---

<SiteLayout
  title={`${gearType.label} ${format} archive | ${site.name}`}
  description={`${format[0].toUpperCase()}${format.slice(1)} posts about ${gearType.label.toLowerCase()} from Nether.`}
>
  <GearTypeArchive gearType={gearType} posts={posts} format={format} />
</SiteLayout>
