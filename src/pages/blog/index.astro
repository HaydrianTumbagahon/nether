---
import { getSitePosts, getPostSlug } from "../../lib/posts";
import ArchiveFilters from "../../components/ArchiveFilters";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../config/site";

const posts = await getSitePosts();
const archivePosts = posts.map((post) => ({
  slug: getPostSlug(post),
  title: post.data.title.replace(/^TEST:\s*/i, ""),
  description: post.data.description,
  category: post.data.category,
  categoryLabel:
    site.categories.find((category) => category.slug === post.data.category)
      ?.label ?? post.data.category,
  date: new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(post.data.pubDate),
  tags: post.data.tags,
  body: post.body ?? "",
}));
---

<SiteLayout
  title={`All Posts | ${site.name}`}
  description={`Browse every post on ${site.name}, newest first.`}
>
  <main class="archive-page">
    <header class="archive-header">
      <h1>All posts</h1>
    </header>
    <ArchiveFilters client:load posts={archivePosts} />
  </main>
</SiteLayout>
