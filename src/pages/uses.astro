---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="What I Use | Nether"
  description="The computer, software, and gear I use at my desk."
>
  <main class="archive-page uses-page">
    <header class="archive-header">
      <h1>What I use</h1>
      <p>Setup details are listed here when they are available to share.</p>
    </header>
    <div class="uses-tables">
      <section>
        <h2>Computer</h2>
        <div class="table-scroll">
          <table class="uses-table">
            <tbody>
              <tr>
                <th scope="row">Model</th>
                <td>Not listed.</td>
              </tr>
              <tr>
                <th scope="row">Key details</th>
                <td>Not listed.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      <section>
        <h2>Keyboard</h2>
        <div class="table-scroll">
          <table class="uses-table">
            <tbody>
              <tr>
                <th scope="row">Model</th>
                <td>Not listed.</td>
              </tr>
              <tr>
                <th scope="row">Layout or switches</th>
                <td>Not listed.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      <section>
        <h2>Mouse</h2>
        <div class="table-scroll">
          <table class="uses-table">
            <tbody>
              <tr>
                <th scope="row">Model</th>
                <td>Not listed.</td>
              </tr>
              <tr>
                <th scope="row">Settings</th>
                <td>Not listed.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      <section>
        <h2>Headphones</h2>
        <div class="table-scroll">
          <table class="uses-table">
            <tbody>
              <tr>
                <th scope="row">Model</th>
                <td>Not listed.</td>
              </tr>
              <tr>
                <th scope="row">Connection</th>
                <td>Not listed.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      <section>
        <h2>Other</h2>
        <div class="table-scroll">
          <table class="uses-table">
            <tbody>
              <tr>
                <th scope="row">Desk gear</th>
                <td>Not listed.</td>
              </tr>
              <tr>
                <th scope="row">Notes</th>
                <td>Not listed.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
</SiteLayout>
